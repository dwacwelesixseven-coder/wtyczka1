{
  "manifest_version": 3,
  "name": "KSeF – pobieranie miesięczne",
  "version": "1.0.4",
  "description": "Dla każdej firmy w Symfonia KSeF Plus: zakres poprzedniego miesiąca, eksport listy XLS i pobranie faktur (ZIP).",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://app.symfonia.pl/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KSeF – pobieranie miesięczne"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.symfonia.pl/earchive*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.symfonia.pl/earchive*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": ""
}
